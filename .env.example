# Copy this file to .env and fill in real values. Never commit the real .env.

# A GitHub personal access token with "repo" scope (classic) or
# "Contents: read & write" (fine-grained), scoped to the repo below.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The account/org and repo you want records pushed to.
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=your-metadata-records-repo
GITHUB_BRANCH=main
