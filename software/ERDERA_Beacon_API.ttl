<https://saracuriel.github.io/FDP-DataService-records/software/ERDERA_Beacon_API.ttl> a dcat:Resource, dcat:DataService ;
    dcterms:identifier "https://saracuriel.github.io/FDP-DataService-records/software/ERDERA_Beacon_API.ttl"^^xsd:string ;
    ejprd:vpConnection ejprd:VPDiscoverable ;
    rdfs:isDefinedBy "https://saracuriel.github.io/FDP-DataService-records/software/ERDERA_Beacon_API.ttl"^^xsd:anyURI ;
    dcat:landingPage "https://fairdata.mapi-trust.org/"^^xsd:anyURI ;
    dcterms:title "ERDERA Beacon API"^^xsd:string ;
    rdfs:label "ERDERA_Beacon_API"^^xsd:string ;
    vivo:abbreviation "ERDERA_Beacon_API"^^xsd:string ;
    dcterms:description """The ERDERA Beacon API provides a machine-actionable discovery service for Clinical Outcome Assessments (COAs) available within the ERDERA ecosystem. It implements a Level 1 Beacon service, allowing users to determine whether matching COAs exist and to retrieve the number of matching resources without exposing individual resource records. Queries can be performed using COA acronym, COA full name, therapeutic indication name and Orphanet rare disease identifiers. The service supports the FAIR principles by improving the findability and machine accessibility of rare disease research resources."""^^xsd:string ;
    dcat:keyword "rare diseases"^^xsd:string, "Clinical Outcome Assessments"^^xsd:string, "COA"^^xsd:string, "Orphanet"^^xsd:string, "therapeutic indications"^^xsd:string ;
    dcat:theme <https://w3id.org/ejp-rd/vocabulary#VPBeacon2_individuals> ;
    dcat:version "1.1.0"^^xsd:string ;
    dcterms:license <https://eprovide.mapi-trust.org/about/about-proqolid> ;
    ftr:status "Active"@en ;
    dcterms:language "http://id.loc.gov/vocabulary/iso639-1/en"^^xsd:anyURI ;
    foaf:logo <https://eprovide.mapi-trust.org/assets/images/eprovide-logo.png> ;
    dcat:endpointURL <https://fairdata.mapi-trust.org/beacon> ;
    dcat:endpointDescription "https://fairdata.mapi-trust.org/beacon/doc"^^xsd:string ;
    dcterms:publisher  <https://orcid.org/0000-0001-6755-9501>  ;
    dcat:contactPoint  <https://orcid.org/0000-0001-6755-9501>  .

<https://orcid.org/0000-0001-6755-9501> a vcard:Individual, foaf:Agent ;
    vcard:fn "Céline Gleizes"^^xsd:string ;
