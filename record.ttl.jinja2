@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .

# NOTE: this identifier drives where the file lands in GitHub —
# the proxy reads {category} and {record_id} straight out of this URI.
<https://example.org/records/{{ category }}/{{ record_id }}>
    a dcat:Dataset ;
    dcterms:identifier <https://example.org/records/{{ category }}/{{ record_id }}> ;
    dcterms:title "{{ title }}" ;
    dcterms:description "{{ description }}" ;
{% if creators %}
{% for creator in creators %}
    dcterms:creator [ a foaf:Agent ; foaf:name "{{ creator }}" ] ;
{% endfor %}
{% endif %}
{% if keywords %}
{% for kw in keywords %}
    dcat:keyword "{{ kw }}" ;
{% endfor %}
{% endif %}
{% if license %}
    dcterms:license <{{ license }}> ;
{% endif %}
    dcterms:created "{{ created_date }}"^^dcterms:W3CDTF .
